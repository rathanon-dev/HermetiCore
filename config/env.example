# ======================================================================
# HermetiCore Environment Configuration Template
# Standard: ISO/IEC/IEEE 12207 | Zero-Leak Security Standard
# Copy this file to 'config/.env' and fill in your private credentials.
# ======================================================================

# GitHub Personal Access Token (Fine-grained or Classic PAT)
# Required for GitHub MCP Server (@modelcontextprotocol/server-github)
# Generate at: https://github.com/settings/tokens?type=beta
# Permissions needed: Contents (Read/Write), Issues (Read/Write), Pull Requests (Read/Write)
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Local LAN Proxy (Optional - Default: http://192.168.1.10:8080)
OMNIPROXY_URL="http://192.168.1.10:8080"
