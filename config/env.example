# ======================================================================
# HermetiCore Environment Configuration Template
# Standard: ISO/IEC/IEEE 12207 | Zero-Leak Security Standard
# Instructions:
# 1. Copy this file to 'config/.env'
# 2. Fill in your device-specific credentials below.
# 3. DO NOT commit 'config/.env' to version control (guarded by .gitignore).
# ======================================================================

# ----------------------------------------------------------------------
# 1. GitHub Personal Access Token (Fine-Grained PAT)
# ----------------------------------------------------------------------
# Required for: GitHub MCP Server (@modelcontextprotocol/server-github) & AI Workflows
# Generate at: https://github.com/settings/personal-access-tokens/new
# Token Name Recommendation:
#   - Main PC: 'HermetiCore-MainPC'
#   - Laptop:  'HermetiCore-Laptop'
# Required Permissions:
#   - Repositories (All): Contents (R/W), Actions (R/W), Workflows (R/W), Issues (R/W), Pull requests (R/W)
#   - Account: Email addresses (Read), Profile (Read), Gists (R/W)
GITHUB_PERSONAL_ACCESS_TOKEN=""

# ----------------------------------------------------------------------
# 2. Local LAN Proxy / OmniProxy Gateway (Optional)
# ----------------------------------------------------------------------
# Fast mirror / cache for Tier 1 toolchain downloads and runtime dependencies
# Default: http://192.168.1.10:8080 (Leave blank if not on LAN proxy)
OMNIPROXY_URL="http://192.168.1.10:8080"
