# ======================================================================
# HERMETICORE GIT IGNORE SPECIFICATION
# Keep the upstream repository ultra-lightweight (< 100 KB)
# Standard: ISO/IEC/IEEE 12207 Zero-Contamination Standard
# ======================================================================

# Ephemeral Tools & Runtime Binaries (Auto-downloaded by setup.ps1)
tools/
temp/
*.zip
*.7z
*.tar.gz

# Root lockfile (transient, auto-deleted by setup.ps1)
.setup-lock

# Node.js & Python dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/
env/

# System & Session Logs
logs/*.jsonl
logs/*.log
!logs/AI_MULTI_AGENT_LOG.md
!logs/ADHD_STRESS_TEST_REPORT.md

# Active Project Workspaces (Only keep the _template_fullstack)
projects/*
!projects/_template_fullstack/
!projects/_template_fullstack/**

# Ephemeral sandbox temp in ALL project pods — never commit test garbage
projects/**/sandbox/temp/
projects/**/sandbox/demo_users/**/cache/
projects/**/sandbox/demo_users/**/storage/
projects/**/runtime/.env.local

# Playwright browser driver cache (Tier 1 — ephemeral)
tools/playwright-browsers/

# Sensitive Configs, SSH Keys & Local Overrides
config/.env
config/.env.*
config/*.key
config/id_ed25519*
config/id_rsa*
config/local_secrets.json
.env
.env.local
.env.*.local
!config/env.example
!config/README.md

