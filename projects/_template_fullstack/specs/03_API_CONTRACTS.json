{
  "openapi": "3.1.0",
  "info": {
    "title": "FullStack Project API Contract",
    "version": "1.0.0",
    "description": "Standard contract connecting services/web-frontend and services/api-backend"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "timestamp": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
